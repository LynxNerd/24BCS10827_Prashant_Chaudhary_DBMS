-- AGGREGATE FUNCTIONS

-- Count employees in each city
SELECT emp_city, COUNT(*) AS emp_count
FROM employees
GROUP BY emp_city;

-- Average salary of each city
SELECT emp_city, AVG(emp_salary)::NUMERIC(20,2) AS avg_salary
FROM employees
GROUP BY emp_city;

-- Count employees in each city with salary >= 90000
SELECT emp_city,
       SUM(CASE WHEN emp_salary >= 90000 THEN 1 ELSE 0 END) AS emp_count
FROM employees
GROUP BY emp_city
ORDER BY emp_city;

-- Count employees in each city with salary >= 90000
-- Sort by employee count (descending)
SELECT emp_city,
       SUM(CASE WHEN emp_salary >= 90000 THEN 1 ELSE 0 END) AS emp_count
FROM employees
GROUP BY emp_city
ORDER BY emp_count DESC;

-- Maximum salary in each city
SELECT emp_city, MAX(emp_salary) AS max_salary
FROM employees
GROUP BY emp_city;

-- Cities where maximum salary is at least 90000
SELECT emp_city, MAX(emp_salary) AS max_salary
FROM employees
GROUP BY emp_city
HAVING MAX(emp_salary) >= 90000;

-- Distinct cities
SELECT DISTINCT emp_city
FROM employees;

-- Count of distinct cities
SELECT COUNT(DISTINCT emp_city) AS total_cities
FROM employees;